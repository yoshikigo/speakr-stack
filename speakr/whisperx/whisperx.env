# WhisperX ASR 服務設定 → ~/.config/whisperx/whisperx.env
# 改完：systemctl --user restart whisperx.service
# 注意：值後面不要接註解（env 檔會把註解當成值的一部分）

# ---------------------------------------------------------------- 轉錄交給 asr-server（Breeze-ASR-25）
# whisperx 只做：對齊（字級時間）、說話者分辨、聲紋
ASR_BACKEND=external
EXTERNAL_ASR_MODE=transcriptions
EXTERNAL_ASR_BASE_URL=http://127.0.0.1:8098/v1
EXTERNAL_ASR_API_KEY=not-needed
EXTERNAL_ASR_MODEL=breeze-asr-25
# 整檔一次送；4 小時錄音轉錄約 16 分鐘，給足
EXTERNAL_ASR_TIMEOUT_SECONDS=3600
# 用 Qwen3 forced aligner：支援中英夾雜，也吃繁體字
# （預設的中文 wav2vec2 對齊模型是簡體字表，遇到 asr-server 輸出的繁體字會對不齊）
EXTERNAL_ASR_ALIGNER=qwen

# ---------------------------------------------------------------- 說話者分辨
# 依說話者切換重新切段，搶話時不會把兩個人併成一段
RESEGMENT_BY_SPEAKER=true
# 落在任何說話區間外的句子，指派給最近的說話者（避免無標籤的句子）
DIARIZE_FILL_NEAREST=true
# 兩個聲音很像被併成同一人時調低（例如 0.5），人數被拆太多時調高
# DIARIZE_CLUSTERING_THRESHOLD=0.5

# ---------------------------------------------------------------- GPU / 記憶體
DEVICE=cuda
COMPUTE_TYPE=float16
BATCH_SIZE=8
GPU_CONCURRENCY=1
# external 模式不載入 Whisper 模型
PRELOAD_MODEL=
# 分辨模型閒置 5 分鐘就卸載，把 VRAM 還給 Ollama 做摘要
MODEL_KEEP_ALIVE_SECONDS=300
MAX_FILE_SIZE_MB=1000

# ---------------------------------------------------------------- 其他
SERVE_MODE=simple
CACHE_DIR=/.cache
HF_HOME=/.cache
NLTK_DATA=/.cache/nltk_data
