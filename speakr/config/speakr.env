# Speakr 設定 → 放在 ~/.config/speakr/speakr.env（install.sh 會複製並填好 APP_BASE_URL）
# 改完：systemctl --user restart speakr.service

# ---------------------------------------------------------------- 語音轉文字：asr-server (Breeze-ASR-25)
TRANSCRIPTION_CONNECTOR=openai_whisper
TRANSCRIPTION_BASE_URL=http://127.0.0.1:8098/v1
TRANSCRIPTION_API_KEY=not-needed
TRANSCRIPTION_MODEL=breeze-asr-25
# 上傳時可以從下拉選單改用 large-v3
TRANSCRIPTION_MODELS_AVAILABLE=breeze-asr-25,whisper-large-v3
# Speakr 先把長錄音切成 10 分鐘的 mp3 再逐段送（重疊 3 秒避免斷句漏字）
CHUNK_LIMIT=10m
CHUNK_OVERLAP_SECONDS=3

# ---------------------------------------------------------------- 摘要 / 標題 / 對話：Ollama（經 metrics proxy，Grafana 看得到 token 用量）
TEXT_MODEL_BASE_URL=http://127.0.0.1:11435/v1
TEXT_MODEL_API_KEY=ollama
# 一定要用 num_ctx 夠大的模型，否則長逐字稿會被 Ollama 默默截斷（見 README「模型選擇」）
TEXT_MODEL_NAME=qwen3.8-27b-ud-64k
SUMMARY_MAX_TOKENS=8000
CHAT_MAX_TOKENS=5000
# 27B 思考模式加長摘要可能跑好幾分鐘
LLM_REQUEST_TIMEOUT=1800
# Ollama 有 prefix cache：標題和摘要共用逐字稿前綴，只 prefill 一次
PREFIX_CACHE_OPTIMIZED_PROMPTS=true

# ---------------------------------------------------------------- 跨錄音搜尋 / 提問（Inquire Mode）— 預設關，見 README
ENABLE_INQUIRE_MODE=false
# EMBEDDING_BASE_URL=http://127.0.0.1:11435/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=qwen3-embedding:4b

# ---------------------------------------------------------------- 帳號 / 安全
ADMIN_USERNAME=henri
# 改成你的 email（Speakr 會驗證格式，不能用 @localhost）；EnvironmentFile 不支援行尾註解
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD 由 podman secret 提供
ALLOW_REGISTRATION=false
# 經 tailscale serve 一律是 HTTPS
SESSION_COOKIE_SECURE=true
TRUSTED_PROXY_HOPS=1
# install.sh 會換成實際的 tailnet 網址
APP_BASE_URL=https://REPLACE_ME:8899
ENABLE_PUBLIC_SHARING=false

# ---------------------------------------------------------------- 其他
TIMEZONE=Asia/Taipei
AUDIO_COMPRESS_UPLOADS=true
AUDIO_CODEC=mp3
AUDIO_BITRATE=128k
LOG_LEVEL=INFO
